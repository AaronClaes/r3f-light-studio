{
  "name": "r3f-light-studio",
  "version": "0.1.0",
  "description": "Lighting rigs for react-three-fiber, described by JSON and edited in the browser",
  "keywords": [
    "devtools",
    "editor",
    "lighting",
    "lights",
    "r3f",
    "react",
    "react-three-fiber",
    "three",
    "threejs"
  ],
  "homepage": "https://github.com/AaronClaes/r3f-light-studio#readme",
  "bugs": "https://github.com/AaronClaes/r3f-light-studio/issues",
  "license": "MIT",
  "author": "Aaron Claes (https://github.com/AaronClaes)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronClaes/r3f-light-studio.git",
    "directory": "packages/light-studio"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite/index.d.ts",
        "default": "./dist/vite/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm build && node -e \"require('fs').copyFileSync('../../README.md','README.md')\"",
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@react-three/drei": "catalog:",
    "@react-three/fiber": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "leva": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10",
    "@react-three/fiber": ">=9",
    "leva": "^0.10",
    "react": ">=19",
    "react-dom": ">=19",
    "three": ">=0.180",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
